---
import Section from '../components/Section.astro'
import ScrollReveal from '../components/ScrollReveal.astro'
import ApplyModal from '../components/ApplyModal.vue'
import CareerList from '../components/CareerList.vue'
import CareersProcess from '../components/organisms/CareersProcess.astro'
import CareersCulture from '../components/organisms/CareersCulture.astro'

export interface Props {
  dict: Record<string, unknown>
  locale?: string
}

const { dict, locale = 'es' } = Astro.props
const careers = (dict as any).careers
const isEn = locale === 'en'
---

<!-- Hero -->
<Section class="!pt-32 md:!pt-40 !pb-lg md:!pb-xl">
  <div class="flex flex-col gap-base stagger-header">
    <div class="inline-flex items-center gap-sm bg-surface-charcoal/50 border border-electric-blue/30 w-fit px-4 py-1.5 rounded-full">
      <span class="w-2 h-2 rounded-full bg-electric-blue animate-pulse"></span>
      <span class="font-label-mono text-label-mono text-electric-blue tracking-wider uppercase">{careers.hero.badge}</span>
    </div>
    <h1 class="font-display-lg text-headline-lg-mobile md:text-headline-lg text-on-surface max-w-4xl">
      {careers.hero.title}<br />
      <span class="bg-gradient-to-r from-electric-blue to-sky-400 bg-clip-text text-transparent">{careers.hero.titleAccent}</span>
    </h1>
    <p class="font-body-lg text-body-lg max-sm:text-body-md text-slate-text max-w-3xl">
      {careers.hero.description}
    </p>
    <div class="pt-sm">
      <a
        href="#vacantes"
        class="inline-flex items-center gap-2 rounded-lg bg-electric-blue px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-electric-blue/90 hover:shadow-lg hover:shadow-electric-blue/25 w-fit"
      >
        {careers.hero.cta}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>
</Section>

<!-- Stats bar -->
<section class="relative border-y border-outline-variant/10 bg-surface-container-lowest">
  <div class="max-w-[min(90vw,1600px)] mx-auto px-margin py-6 md:py-8">
    <ScrollReveal>
      <div id="careers-stats" class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-electric-blue/10 text-electric-blue">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.706c-.979 0-1.932-.155-2.833-.453m-8.5.629c.984 0 1.94-.165 2.847-.473m6.462.543a2.18 2.18 0 00.847-1.266V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m0 0A48.086 48.086 0 0012 5.25c-1.372 0-2.735.078-4.076.231-1.061.159-1.837.984-1.837 2.045v3.794c0 1.08.768 2.015 1.837 2.175.54.08 1.087.144 1.64.207m0 0v-4.5" />
            </svg>
          </span>
          <div>
            <span id="stats-count" class="font-display-lg text-headline-sm text-on-surface">0</span>
            <span class="font-body-md text-body-md text-slate-text ml-1">{careers.stats.positions}</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-vue-green/10 text-vue-green">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M21.75 9.394c-5.445-5.444-14.055-5.444-19.5 0" />
            </svg>
          </span>
          <span class="font-display-lg text-headline-sm text-on-surface">{careers.stats.remote}</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-electric-blue/10 text-electric-blue">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
          </span>
          <span class="font-display-lg text-headline-sm text-on-surface">{careers.stats.talent}</span>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>

<!-- Recruitment Process -->
<CareersProcess dict={dict} />

<!-- Culture -->
<CareersCulture dict={dict} />

<!-- Vacancies -->
<section id="vacantes" class="py-lg md:py-xl bg-surface-container-lowest border-y border-outline-variant/10">
  <div class="max-w-[min(90vw,1600px)] mx-auto px-margin">
    <ScrollReveal>
      <div class="flex flex-col items-center gap-base text-center mb-12 md:mb-16">
        <h2 class="font-display-lg text-headline-lg-mobile md:text-headline-lg text-on-surface max-w-3xl">
          {isEn ? 'Open Positions' : 'Vacantes Abiertas'}
        </h2>
        <p class="font-body-lg text-body-lg max-sm:text-body-md text-slate-text max-w-2xl">
          {isEn ? 'Explore our current openings and find the role that fits you best.' : 'Explorá nuestras vacantes actuales y encontrá el rol que mejor se ajuste a vos.'}
        </p>
      </div>
    </ScrollReveal>

    <CareerList client:load locale={locale} dict={dict} />
  </div>
</section>

<!-- CTA -->
<section class="py-lg md:py-xl relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-electric-blue/5 via-transparent to-vue-green/5"></div>
  <div class="max-w-[min(90vw,1600px)] mx-auto px-margin relative">
    <ScrollReveal>
      <div class="rounded-2xl border border-electric-blue/15 bg-surface-container-lowest p-8 md:p-12 text-center max-w-3xl mx-auto">
        <h2 class="font-display-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-4">
          {careers.cta_line.title}
        </h2>
        <p class="font-body-lg text-body-lg text-slate-text mb-8">
          {careers.cta_line.desc}
        </p>
        <a
          href={isEn ? '/en/contacto' : '/contacto'}
          class="inline-flex items-center gap-2 rounded-lg border border-electric-blue/30 bg-electric-blue/10 px-6 py-3 text-sm font-semibold text-electric-blue transition-all duration-300 hover:bg-electric-blue/20 hover:shadow-lg hover:shadow-electric-blue/10"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          {careers.cta_line.cta}
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>

<ApplyModal client:load dict={dict} locale={locale} />
